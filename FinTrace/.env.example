# FinTrace Environment Variables

# ========== DATABASE CONFIGURATION ==========
# MongoDB
MONGODB_URI=mongodb://mongo:27017/fintrace
MONGODB_USER=admin
MONGODB_PASSWORD=admin123

# Neo4j
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# Redis
REDIS_URL=redis://redis:6379

# ========== BACKEND CONFIGURATION ==========
BACKEND_PORT=5000
NODE_ENV=development
LOG_LEVEL=info

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRY=24h
JWT_REFRESH_EXPIRY=7d

# CORS
CORS_ORIGIN=http://localhost:3000

# ========== FRONTEND CONFIGURATION ==========
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_ML_URL=http://localhost:8000

# ========== ML SERVICE CONFIGURATION ==========
ML_SERVICE_PORT=8000
ML_SERVICE_URL=http://ml-service:8000
ML_MODEL_PATH=./models
ANOMALY_THRESHOLD=0.7

# ========== SECURITY ==========
# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Session
SESSION_SECRET=your-session-secret-key

# ========== EMAIL & NOTIFICATIONS ==========
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# SendGrid (alternative)
SENDGRID_API_KEY=

# ========== AWS (Optional for cloud deployment) ==========
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=fintrace-reports

# ========== EXTERNAL SERVICES ==========
# Sentry for error tracking
SENTRY_DSN=

# DataDog for monitoring
DATADOG_API_KEY=

# ========== FEATURES ==========
ENABLE_WEBSOCKET_ALERTS=true
ENABLE_REAL_TIME_PROCESSING=true
ENABLE_ML_ANOMALY_DETECTION=true

# ========== FRAUD DETECTION THRESHOLDS ==========
HIGH_RISK_SCORE_THRESHOLD=0.8
MEDIUM_RISK_SCORE_THRESHOLD=0.5
VELOCITY_ANOMALY_THRESHOLD=3
LAYERING_DETECTION_HOPS=5
CIRCULAR_TRANSFER_THRESHOLD=4

# ========== INVESTIGATOR SETTINGS ==========
MAX_EXPORT_TRANSACTIONS=10000
PDF_GENERATION_TIMEOUT=30000

# ========== DEVELOPMENT ==========
DEBUG=fintrace:*
SEED_DATABASE_ON_START=false
GENERATE_SAMPLE_DATA=false
